# Production environment variables - replace every placeholder before deployment

# Authentication and JWT
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (Neon recommended for production)
# Requires the psycopg[binary] package.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST/DB_NAME?sslmode=require&channel_binding=require
# Local-development alternative:
# DATABASE_URL=sqlite:///./data/forensics.db

# Server and security
# Use your actual frontend origin in production.
CORS_ALLOWED_ORIGINS=https://your-domain.example
ENABLE_DEMO_ENDPOINTS=false
MAX_UPLOAD_SIZE_BYTES=52428800
LOG_LEVEL=INFO

# Optional: enables AI-generated executive narratives.
# GEMINI_API_KEY and GOOGLE_API_KEY are both supported; set only one.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
