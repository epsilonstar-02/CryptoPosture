# ============================================================
# Email Cryptographic Forensics Framework — Environment Config
# ============================================================

# --- LLM Executive Narrative (AI-Assisted Summary) -----------
# Set either key to enable LLM-generated executive summaries.
# Uses gemini-2.5-flash via the Google Gen AI SDK.
# If neither is set, ai_narrative.skipped_reason="NO_API_KEY"
# is returned and all other analysis runs normally.
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=alternative-key-name-also-accepted

# --- Server -------------------------------------------------
# LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE_BYTES=52428800   # 50 MB default
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# ENABLE_DEMO_ENDPOINTS=true
